# Gemini API (required) — server-side only, never use REACT_APP_ prefix
# Get at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# MongoDB Atlas connection string (required for persistence + RAG)
# Format: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
MONGODB_URI=your_mongodb_connection_string

# RAG: Vector search index name (must match your Atlas vector index on rag_docs.sherlock_holmes)
RAG_VECTOR_INDEX=vector_index

# Password gate (optional) — validated server-side; omit both to disable the gate locally
GATE_PASSWORD=your_gate_password
# Random secret for signing auth cookies (required when GATE_PASSWORD is set)
AUTH_SECRET=generate_a_long_random_string

# ElevenLabs TTS (optional)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=

# Server port (optional, default 3001)
PORT=3001

# Split deployment only: frontend API base URL (leave empty for same-origin single service)
REACT_APP_API_URL=
