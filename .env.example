# Gemini API (required for chat + RAG embedding)
# Get at https://aistudio.google.com/apikey
REACT_APP_GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY=your_gemini_api_key

# MongoDB Atlas connection string (required)
# Format: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
REACT_APP_MONGODB_URI=your_mongodb_connection_string

# RAG: Vector search index name (must match your Atlas vector index on rag_docs.sherlock_holmes)
# Create in Atlas: Search > Create Index > vector type on "embedding" field
RAG_VECTOR_INDEX=vector_index

# Frontend password gate (optional)
# Used by the drag-to-unlock gate in App.js
REACT_APP_GATE_PASSWORD=sherlock
